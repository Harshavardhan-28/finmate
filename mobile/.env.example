# API base URL. Leave empty to auto-detect your dev machine on port 8000.
# Physical phone on the same Wi-Fi: http://<your-computer-LAN-IP>:8000
# Android emulator: http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=

# Public HTTPS address of the backend, used only for Google sign-in (Google rejects http LAN redirects).
# e.g. the ngrok URL from `ngrok http 8000`. Leave empty to reuse the API address.
EXPO_PUBLIC_AUTH_URL=
