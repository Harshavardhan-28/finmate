# Copy to .env and fill in. Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional: Gemini model for the cloud provider (default gemini-2.5-flash)
# FINMATE_MODEL=gemini-2.5-flash

# ---- Which model family runs the agents, receipt OCR and voice ----------------------
# gemini  = Gemini in the cloud (needs GOOGLE_API_KEY above)
# ollama  = small quantized models on this machine, nothing leaves it (see below)
FINMATE_LLM_PROVIDER=gemini

# Ollama settings (used only when FINMATE_LLM_PROVIDER=ollama). Tags are 4-bit quantized (Q4_K_M).
# Sized for a 24 GB Apple-silicon Mac: every model is 2-5 GB and the weights are shared, so ~11 GB resident.
#   ollama pull qwen3:8b ; ollama pull qwen3:4b ; ollama pull qwen2.5vl:3b
# OLLAMA_API_BASE=http://localhost:11434
# FINMATE_OLLAMA_ORCHESTRATOR_MODEL=qwen3:8b   # routes + merges answers: needs the best tool-calling
# FINMATE_OLLAMA_INSIGHTS_MODEL=qwen3:8b       # numeric reasoning + readable advice
# FINMATE_OLLAMA_RECEIPT_MODEL=qwen3:4b        # fixed OCR -> propose -> save sequence; also reads voice transcripts
# FINMATE_OLLAMA_BUDGET_MODEL=qwen3:4b         # one tool call + summary
# FINMATE_OLLAMA_FAMILY_MODEL=qwen3:4b         # role check + household summary
# FINMATE_OLLAMA_MODEL=qwen3:8b                # fallback for any agent not listed above
# FINMATE_OLLAMA_VISION_MODEL=qwen2.5vl:3b     # receipt photos. Prefer a NON-thinking model: qwen3-vl:4b spends thousands of
#                                              # tokens "thinking" and can run out before finishing a long itemised bill.
# FINMATE_OLLAMA_BILL_NUM_PREDICT=3500         # token budget for reading one bill with all its items
# FINMATE_WHISPER_MODEL=small                  # voice notes, local faster-whisper (tiny/base/small)
# FINMATE_OLLAMA_NUM_CTX=8192                  # Ollama's default context is too small for the agent prompts
# FINMATE_OLLAMA_KEEP_ALIVE=30m                # keep models loaded between requests

# Postgres from `docker compose up -d db` (repo root). This is the default if unset.
DATABASE_URL=postgresql://finmate:finmate@localhost:5432/finmate

# Auth. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
# COOKIE_SECURE=1   # set when serving over https

# Google sign-in (optional; the button is hidden until both are set).
# Authorized redirect URI in Google Cloud Console: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# MCP tool server (real standalone server; the API starts it in development).
# FINMATE_MCP_URL=http://127.0.0.1:8001/mcp
# FINMATE_MCP_AUTOSTART=1   # set 0 when the tool server runs as its own service
# TOOL_TOKEN_SECRET=        # signs per-call tool tokens; derived from JWT_SECRET if unset
